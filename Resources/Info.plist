<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>nxtch</string>
    <key>CFBundleDisplayName</key><string>nxtch</string>
    <key>CFBundleIdentifier</key><string>dev.nxtch.app</string>
    <key>CFBundleExecutable</key><string>Nxtch</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.5.0</string>
    <key>CFBundleVersion</key><string>5</string>
    <key>LSMinimumSystemVersion</key><string>14.2</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <!-- Files nxtch writes (shelf drops) get the quarantine flag, so Gatekeeper still checks them. -->
    <key>LSFileQuarantineEnabled</key><true/>
    <key>NSAudioCaptureUsageDescription</key>
    <string>nxtch taps each app's audio so it can change that app's volume.</string>
</dict>
</plist>
